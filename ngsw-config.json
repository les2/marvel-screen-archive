{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {"name":"app","installMode":"prefetch","resources":{"files":["/favicon.svg","/index.html","/manifest.webmanifest","/*.css","/*.js"]}},
    {"name":"catalog-data","installMode":"prefetch","updateMode":"prefetch","resources":{"files":["/data/**/*.json"]}}
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**"]
}
