{
  "name": "marvel-archive",
  "version": "0.1.0",
  "private": false,
  "description": "A fast, offline-first Marvel screen universe explorer and open JSON dataset.",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "ng serve --host 127.0.0.1",
    "build": "ngc -p tsconfig.app.json && node scripts/build-static.mjs && node scripts/prepare-sites-build.mjs",
    "test": "tsc -p tsconfig.spec.json --noEmit && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@openai/sites-vite-plugin": "0.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@babel/core": "^8.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
